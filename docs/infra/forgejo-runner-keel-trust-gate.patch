@@ -0,0 +1,74 @@
+// Copyright 2026 The Keel Linux project. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package run
+
+import (
+	"testing"
+
+	runnerv1 "code.forgejo.org/forgejo/actions-proto/runner/v1"
+	"google.golang.org/protobuf/types/known/structpb"
+
+	"code.forgejo.org/forgejo/runner/v13/internal/pkg/labels"
+)
+
+func trustTask(t *testing.T, eventName string, pr map[string]any) *runnerv1.Task {
+	t.Helper()
+	ctx := map[string]any{
+		"event_name": eventName,
+		"repository": "Keel-Linux/inithooks",
+		"event":      map[string]any{},
+	}
+	if pr != nil {
+		ctx["event"] = map[string]any{"pull_request": pr}
+	}
+	s, err := structpb.NewStruct(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &runnerv1.Task{Context: s}
+}
+
+func prFrom(repo string, flow any) map[string]any {
+	pr := map[string]any{"head": map[string]any{"repo": map[string]any{"full_name": repo}}}
+	if flow != nil {
+		pr["flow"] = flow
+	}
+	return pr
+}
+
+func TestKeelTrustGate(t *testing.T) {
+	host := labels.Labels{labels.MustParse("keel-host:host"), labels.MustParse("keel-lxc:host")}
+	ctr := labels.Labels{labels.MustParse("keel-container:docker://keel-ci:trixie")}
+	mixed := labels.Labels{labels.MustParse("keel-container:docker://keel-ci:trixie"), labels.MustParse("keel-host:host")}
+	lxc := labels.Labels{labels.MustParse("x:lxc://debian:trixie")}
+
+	cases := []struct {
+		name    string
+		task    *runnerv1.Task
+		ls      labels.Labels
+		refused bool
+	}{
+		{"push on host", trustTask(t, "push", nil), host, false},
+		{"same repository pull request on host", trustTask(t, "pull_request", prFrom("keel-linux/inithooks", 0)), host, false},
+		{"fork pull request on host", trustTask(t, "pull_request", prFrom("emiliano-go/inithooks", 0)), host, true},
+		{"fork pull_request_target on host", trustTask(t, "pull_request_target", prFrom("emiliano-go/inithooks", 0)), host, true},
+		{"AGit pull request on host", trustTask(t, "pull_request", prFrom("Keel-Linux/inithooks", 1)), host, true},
+		{"pull request without flow on host", trustTask(t, "pull_request", prFrom("Keel-Linux/inithooks", nil)), host, true},
+		{"pull request without head on host", trustTask(t, "pull_request", map[string]any{"flow": 0}), host, true},
+		{"pull request without payload on host", trustTask(t, "pull_request", nil), host, true},
+		{"fork pull request on lxc backend", trustTask(t, "pull_request", prFrom("emiliano-go/inithooks", 0)), lxc, true},
+		{"fork pull request on a mixed runner", trustTask(t, "pull_request", prFrom("emiliano-go/inithooks", 0)), mixed, true},
+		{"fork pull request on a runner without labels", trustTask(t, "pull_request", prFrom("emiliano-go/inithooks", 0)), labels.Labels{}, true},
+		{"fork pull request on container", trustTask(t, "pull_request", prFrom("emiliano-go/inithooks", 0)), ctr, false},
+		{"AGit pull request on container", trustTask(t, "pull_request", prFrom("Keel-Linux/inithooks", 1)), ctr, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			err := keelTrustGate(c.task, c.ls)
+			if (err != nil) != c.refused {
+				t.Fatalf("refused=%v, want %v (%v)", err != nil, c.refused, err)
+			}
+		})
+	}
+}
