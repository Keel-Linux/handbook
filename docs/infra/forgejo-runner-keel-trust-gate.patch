diff --git a/internal/app/run/trust.go b/internal/app/run/trust.go
new file mode 100644
index 0000000..35b8964
--- /dev/null
+++ b/internal/app/run/trust.go
@@ -0,0 +1,70 @@
+// Copyright 2026 The Keel Linux project. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package run
+
+import (
+	"fmt"
+	"strings"
+
+	runnerv1 "code.forgejo.org/forgejo/actions-proto/runner/v1"
+
+	"code.forgejo.org/forgejo/runner/v13/internal/pkg/labels"
+)
+
+// Keel trust gate (handbook docs/infra/keel-lxc-2.md, "Fork pull
+// requests run in a container"). A job of a pull request that does not
+// come from a branch of the repository itself (a fork, an AGit push, or
+// an event that does not say) runs only on a runner whose every label is
+// a container backend. A runner with a host or lxc label refuses it
+// before any step runs. The rule is compiled in: no configuration file
+// that the runner user can write turns it off.
+
+// untrustedPullRequest returns a reason when the task is a pull request
+// event whose code does not come from a branch of the base repository.
+func untrustedPullRequest(task *runnerv1.Task) string {
+	fields := task.GetContext().GetFields()
+	eventName := fields["event_name"].GetStringValue()
+	if !strings.HasPrefix(eventName, "pull_request") {
+		return ""
+	}
+	repository := fields["repository"].GetStringValue()
+	pr := fields["event"].GetStructValue().GetFields()["pull_request"].GetStructValue().GetFields()
+	flow, hasFlow := pr["flow"]
+	head := pr["head"].GetStructValue().GetFields()
+	headRepo := head["repo"].GetStructValue().GetFields()["full_name"].GetStringValue()
+	switch {
+	case !hasFlow:
+		return fmt.Sprintf("event %s: the pull request has no flow field", eventName)
+	case flow.GetNumberValue() != 0:
+		return fmt.Sprintf("event %s: the pull request is not from a branch (AGit flow)", eventName)
+	case repository == "" || headRepo == "":
+		return fmt.Sprintf("event %s: the head or base repository is not known", eventName)
+	case !strings.EqualFold(headRepo, repository):
+		return fmt.Sprintf("event %s: the pull request is from %s, not from %s", eventName, headRepo, repository)
+	}
+	return ""
+}
+
+// containerOnly is true when the runner has labels and all of them use
+// the docker backend, so a job cannot run its steps on the host.
+func containerOnly(ls labels.Labels) bool {
+	if len(ls) == 0 {
+		return false
+	}
+	for _, label := range ls {
+		if label.Schema != labels.SchemeDocker {
+			return false
+		}
+	}
+	return true
+}
+
+// keelTrustGate returns an error when this runner must not run the task.
+func keelTrustGate(task *runnerv1.Task, ls labels.Labels) error {
+	reason := untrustedPullRequest(task)
+	if reason == "" || containerOnly(ls) {
+		return nil
+	}
+	return fmt.Errorf("refused by the Keel trust gate: %s; a pull request from a fork runs only on a container runner (runs-on: keel-container), see handbook docs/infra/keel-lxc-2.md", reason)
+}
diff --git a/internal/app/run/trust_test.go b/internal/app/run/trust_test.go
new file mode 100644
index 0000000..7927558
